
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Security Lab | SecureWeb Shield</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="navbar">
    <div class="brand">SecureWeb <span>Shield</span></div>
    <span class="status">Security Learning Lab</span>
  </header>

  <main class="container">
    <p class="eyebrow">INTERACTIVE SECURITY LAB</p>
    <h1>Security <span>Playground</span></h1>
    <p class="intro">
      Welcome, <%= username %>. Explore safe output handling and
      server-validated CSRF protection.
    </p>

    <section class="card">
      <div class="symbol">XSS</div>
      <h2>Safe Output Demonstration</h2>
      <p>
        Enter text below. The application will display it as plain text,
        rather than interpreting it as HTML.
      </p>

      <label for="userInput">Test input</label>
      <textarea id="userInput" rows="4"
        placeholder="Enter some sample text..."></textarea>

      <button type="button" id="displayButton">Display Safely</button>

      <h3>Output</h3>
      <pre id="safeOutput" class="output">Your safe output will appear here.</pre>
      <p id="xssStatus" role="status" class="tag"></p>
    </section>

    <section class="card" style="margin-top: 24px;">
      <div class="symbol csrf">CSRF</div>
      <h2>Protected Action Demonstration</h2>
      <p>
        Submit a protected action. The server checks the session's CSRF token
        before accepting the request.
      </p>

      <form action="/security-lab/action" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit">Submit Protected Action</button>
      </form>
    </section>

    <p style="margin-top: 28px;">
      <a href="/dashboard">Back to Dashboard</a>
    </p>

    <form action="/logout" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit">Log Out</button>
    </form>
  </main>

  <script src="/app.js" defer></script>
</body>
</html>
