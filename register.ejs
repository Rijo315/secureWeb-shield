
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register | SecureWeb Shield</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main class="container">
    <h1>Create your account</h1>
    <p class="intro">Register to access the security learning lab.</p>

    <% if (error) { %>
      <p role="alert"><%= error %></p>
    <% } %>

    <form action="/register" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <label for="username">Username</label>
      <input id="username" name="username" required minlength="3" maxlength="30">

      <label for="email">Email</label>
      <input id="email" name="email" type="email" required maxlength="254">

      <label for="password">Password</label>
      <input id="password" name="password" type="password" required minlength="10" maxlength="72">

      <button type="submit">Create account</button>
    </form>

    <p><a href="/">Home</a> · <a href="/login">Already registered? Log in</a></p>
  </main>
</body>
</html>
