
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SecureWeb Shield | Security Learning Lab</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="navbar">
    <h2>SecureWeb Shield</h2>
    <nav>
      <a href="/login">Login</a>
      <a href="/register">Register</a>
    </nav>
  </header>

  <main class="container">

    <h1>Build a safer web,<br>one request at a time.</h1>

    <p>
      An educational web application demonstrating Cross-Site
      Scripting (XSS) and Cross-Site Request Forgery (CSRF) protection.
    </p>

    <section class="event-list">
      <article class="event-card">
        <p><strong>XSS</strong></p>
        <h2>Cross-Site Scripting</h2>
        <p>
          Learn how untrusted input can become dangerous when rendered unsafely.
        </p>
        <a href="/security-lab">Safe output demonstration</a>
      </article>

      <article class="event-card">
        <p><strong>CSRF</strong></p>
        <h2>Cross-Site Request Forgery</h2>
        <p>
          Learn how server-validated tokens help protect sensitive actions.
        </p>
        <a href="/login">Request protection</a>
      </article>
    </section>
  </main>

  <footer class="container">
    <p>SecureWeb Shield · Educational Security Project</p>
  </footer>
</body>
</html>
